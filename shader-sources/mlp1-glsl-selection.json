  "patches": [
    {
      "id": "zfast-crt-geo-precision",
      "source_id": "libretro-glsl-shaders",
      "path": "crt/shaders/zfast_crt_geo.glsl",
      "patch_file": "shader-sources/patches/zfast_crt_geo-precision.patch",
      "pre_sha256": "c0a52a3d1cc6ad380ba62524b9607d9a3eee1b08df61537ed9530a79e755a0c4",
      "post_sha256": "f4723f329f20fa331da901d4c95d84638e750c8ac7ebf1ebd9156131a6e61b4c",
      "reason": "GLSL ES link failure on Mali-G52: TextureSize is mediump in the vertex stage and highp in the fragment stage. Raises the vertex stage to highp under GL_FRAGMENT_PRECISION_HIGH, byte-for-byte the change upstream commit 8aab130 applied to the sibling shaders zfast_crt.glsl and zfast_crt_nogeo.glsl.",
      "upstream_status": "not yet submitted; upstream c6c8fad (#563) introduced the mismatch in six shaders and 8aab130 fixed two of them, leaving this one. Drop this patch once upstream carries the same change."
    }
  ],
  "license_acknowledgements": [
    {
      "path_prefix": "crt/shaders/crt-consumer/",
      "license": "GPL-2.0-or-later",
      "reason": "The crt-consumer shader by DariusG (2022-2024) is one coherent work whose files carry no consistent per-file header: of its ten shaders six declare GPL-2.0-or-later (crt-consumer.glsl, crt-consumer-arcade.glsl, linear.glsl, glow_x.glsl, glow_y.glsl, ntsc_module.glsl) and four declare nothing (crt-consumer-1w.glsl, crt-consumer-classic.glsl, linearize.glsl, resolve.glsl). None declares version 3, so there is no conflict inside the work. The upstream repository has no LICENSE file, so an unlabelled file has no statement anywhere; these are treated as part of the surrounding GPL-2.0-or-later work. Recorded as RetroArch decision 0010.",
      "decision": "0010"
    }
  ],
