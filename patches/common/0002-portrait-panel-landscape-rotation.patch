+/* When video_rotation is 90/270, map the logical landscape coordinate
+ * space to the physical portrait framebuffer (e.g. Miyoo A30 480x640
+ * panel used in landscape).  The axes are swapped and the logical y is
+ * mirrored: a bare transpose is a reflection rather than a rotation,
+ * which places the rectangle on the wrong side of the panel even though
+ * the content drawn inside it comes out upright. */
+static INLINE GLint gl2_rot_x(GLint y, GLsizei h)
+{
+   unsigned vid_width, vid_height;
+   video_driver_get_size(&vid_width, &vid_height);
+   return (GLint)vid_height - y - h;
+}
+
+static INLINE void gl2_viewport_rot(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+   if (config_get_ptr()->uints.video_rotation % 2 != 0)
+      glViewport(gl2_rot_x(y, h), x, h, w);
+   else
+      glViewport(x, y, w, h);
+}
+
+static INLINE void gl2_scissor_rot(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+   if (config_get_ptr()->uints.video_rotation % 2 != 0)
+      glScissor(gl2_rot_x(y, h), x, h, w);
+   else
+      glScissor(x, y, w, h);
+}
