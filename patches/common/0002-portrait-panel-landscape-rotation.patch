diff --git a/gfx/gfx_display.c b/gfx/gfx_display.c
index 85a207c..2781e88 100644
--- a/gfx/gfx_display.c
+++ b/gfx/gfx_display.c
@@ -325,8 +325,13 @@ float gfx_display_get_dpi_scale(
 #ifdef HAVE_OZONE
       if (p_disp->menu_driver_id == MENU_DRIVER_ID_OZONE)
       {
-         /* Ozone has a capped scale factor */
-         float new_width        = (float)width * 0.3333333f;
+         /* Ozone has a capped scale factor — use a relaxed cap for rotated
+          * displays where the logical width is the physical height and the
+          * default 1/3 cap over-constrains the scale (e.g. portrait panel
+          * in landscape). */
+         unsigned vid_rot       = config_get_ptr()->uints.video_rotation;
+         float cap_fraction     = (vid_rot % 2 != 0) ? 0.5f : 0.3333333f;
+         float new_width        = (float)width * cap_fraction;
          if (((float)OZONE_SIDEBAR_WIDTH * adjusted_scale)
                > new_width)
             adjusted_scale      = (new_width / (float)OZONE_SIDEBAR_WIDTH);
