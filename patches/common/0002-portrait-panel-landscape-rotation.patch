    /* Calculate projection. */
    matrix_4x4_ortho(gl->mvp_no_rot, ortho->left, ortho->right,
          ortho->bottom, ortho->top, ortho->znear, ortho->zfar);
 
+   /* Save pure ortho before baking video_rotation into mvp_no_rot.
+    * mvp uses the pure ortho so video_rotation is not applied twice. */
+   ortho_pure = gl->mvp_no_rot;
+
+   /* Bake video_rotation into mvp_no_rot so that OSD, fonts, overlays
