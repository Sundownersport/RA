@@ -1959,8 +1960,14 @@ float video_driver_get_core_aspect(void)
    else
       out_aspect = (float)geom->base_width / geom->base_height;
 
-   /* Flip rotated aspect */
-   if ((retroarch_get_rotation() + retroarch_get_core_requested_rotation()) % 2)
+   /* Flip rotated aspect.
+    * retroarch_get_rotation() includes video_rotation, but video_rotation
+    * represents physical panel orientation (e.g. portrait panel used as
+    * landscape), not content rotation.  Panel rotation is handled by
+    * viewport coordinate swapping instead, so exclude it here by adding
+    * it again — appearing twice, it cancels out in the mod-2 parity check. */
+   if ((retroarch_get_rotation() + retroarch_get_core_requested_rotation()
+            + config_get_ptr()->uints.video_rotation) % 2)
       return (1.0f / out_aspect);
 
