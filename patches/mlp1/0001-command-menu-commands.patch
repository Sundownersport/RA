+bool command_get_info(command_t *cmd, const char *arg)
+{
+   size_t _len                    = 0;
+   char reply[128]                = "";
+   runloop_state_t *runloop_st    = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info  = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned disk_count            = 0;
+   unsigned disk_slot             = 0;
+   bool savestates_enabled        = core_info_current_supports_savestate();
+   (void)arg;
+
+   if (sys_info)
+   {
+      disk_count = disk_control_get_num_images(&sys_info->disk_control);
+      disk_slot  = disk_control_get_image_index(&sys_info->disk_control);
+   }
+
+   _len  = snprintf(reply, sizeof(reply), "GET_INFO %u %u ", disk_count, disk_slot);
+   if (savestates_enabled)
+      _len += snprintf(reply + _len, sizeof(reply) - _len, "%d",
+            (int)runloop_get_current_savestate());
+   else
+      _len += strlcpy(reply + _len, "NO", sizeof(reply) - _len);
+
+   cmd->replier(cmd, reply, _len);
+   return true;
+}
+
+bool command_get_path(command_t *cmd, const char *arg)
+{
+   size_t _len;
+   char reply[PATH_MAX_LENGTH + 64];
+   char state_path[PATH_MAX_LENGTH];
+   const char *value = NULL;
+
+   state_path[0] = '\0';
+
+   if (string_is_equal(arg, "core"))
+      value = path_get(RARCH_PATH_CORE);
+   else if (string_is_equal(arg, "config"))
+      value = path_get(RARCH_PATH_CONFIG);
+   else if (string_is_equal(arg, "content"))
+      value = path_get(RARCH_PATH_CONTENT);
+   else if (string_is_equal(arg, "config_append"))
+      value = path_get(RARCH_PATH_CONFIG_APPEND);
+   else if (string_is_equal(arg, "config_override"))
+      value = path_get(RARCH_PATH_CONFIG_OVERRIDE);
+   else if (string_is_equal(arg, "core_options"))
+      value = path_get(RARCH_PATH_CORE_OPTIONS);
+   else if (string_is_equal(arg, "default_shader_preset"))
+      value = path_get(RARCH_PATH_DEFAULT_SHADER_PRESET);
+   else if (string_is_equal(arg, "basename"))
+      value = path_get(RARCH_PATH_BASENAME);
+   else if (string_is_equal(arg, "subsystem"))
+      value = path_get(RARCH_PATH_SUBSYSTEM);
+   else if (string_is_equal(arg, "savestate"))
+   {
+      runloop_get_current_savestate_path(state_path, sizeof(state_path));
+      value = state_path;
+   }
+   else
+      value = "";
+
+   _len  = strlcpy(reply, "GET_PATH ", sizeof(reply));
+   _len += strlcpy(reply + _len, arg ? arg : "", sizeof(reply) - _len);
+   _len += strlcpy(reply + _len, " ", sizeof(reply) - _len);
+   if (value)
+      _len += strlcpy(reply + _len, value, sizeof(reply) - _len);
+
+   cmd->replier(cmd, reply, _len);
+   return value && value[0];
+}
+
+bool command_get_disk_count(command_t *cmd, const char *arg)
+{
+   char reply[128]               = "";
+   runloop_state_t *runloop_st   = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned disk_count           = sys_info
+      ? disk_control_get_num_images(&sys_info->disk_control)
+      : 0;
+   (void)arg;
+
+   snprintf(reply, sizeof(reply), "GET_DISK_COUNT %u", disk_count);
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
+
+bool command_get_disk_slot(command_t *cmd, const char *arg)
+{
+   char reply[128]               = "";
+   runloop_state_t *runloop_st   = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned disk_slot            = sys_info
+      ? disk_control_get_image_index(&sys_info->disk_control)
+      : 0;
+   (void)arg;
+
+   snprintf(reply, sizeof(reply), "GET_DISK_SLOT %u", disk_slot);
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
+
+bool command_set_disk_slot(command_t *cmd, const char *arg)
+{
+   char reply[128]               = "";
+   char *end                     = NULL;
+   runloop_state_t *runloop_st   = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned long disk            = 0;
+   unsigned disk_count           = sys_info
+      ? disk_control_get_num_images(&sys_info->disk_control)
+      : 0;
+   bool was_ejected              = false;
+   bool ret                      = false;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SET_DISK_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   disk = strtoul(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SET_DISK_SLOT %lu", disk);
+   if (!sys_info || arg == end || (end && *end != '\0') ||
+       disk_count == 0 || disk >= disk_count)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   was_ejected = disk_control_get_eject_state(&sys_info->disk_control);
+   if (!was_ejected)
+      disk_control_set_eject_state(&sys_info->disk_control, true, false);
+   ret = disk_control_set_index(&sys_info->disk_control, (unsigned)disk, true);
+   if (!was_ejected)
+      disk_control_set_eject_state(&sys_info->disk_control, false, false);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return ret;
+}
+
+bool command_get_state_slot(command_t *cmd, const char *arg)
+{
+   char reply[128] = "";
+   (void)arg;
+
+   if (core_info_current_supports_savestate())
+      snprintf(reply, sizeof(reply), "GET_STATE_SLOT %d",
+            (int)runloop_get_current_savestate());
+   else
+      strlcpy(reply, "GET_STATE_SLOT NO", sizeof(reply));
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
+
+bool command_set_state_slot(command_t *cmd, const char *arg)
+{
+   char reply[128] = "";
+   char *end       = NULL;
+   long slot       = 0;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SET_STATE_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   slot = strtol(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SET_STATE_SLOT %ld", slot);
+   if (!core_info_current_supports_savestate() ||
+       arg == end || (end && *end != '\0') || slot < -1)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   runloop_set_current_savestate((int)slot);
+   cmd->replier(cmd, reply, strlen(reply));
+   return true;
+}
+
+bool command_save_state_slot(command_t *cmd, const char *arg)
+{
+   char state_path[PATH_MAX_LENGTH] = "";
+   char reply[128]                  = "";
+   char *end                        = NULL;
+   long slot                        = 0;
+   bool savestates_enabled          = core_info_current_supports_savestate();
+   bool ret                         = false;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SAVE_STATE_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   slot = strtol(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SAVE_STATE_SLOT %ld", slot);
+   if (!savestates_enabled || arg == end ||
+       (end && *end != '\0') || slot < -1)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (!runloop_get_savestate_path(state_path, sizeof(state_path), (int)slot) ||
+       core_serialize_size() == 0)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (slot == -1)
+      ret = content_auto_save_state(state_path);
+   else
+      ret = content_save_state(state_path, true);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return ret;
+}
+
 
