+static void input_config_apply_controller_label(
+      const settings_t *settings,
+      const struct retro_keybind *bind,
+      struct retro_keybind *display_bind)
+{
+   unsigned i;
+   unsigned joy_idx;
+
+   if (!bind || !display_bind)
+      return;
+
+   *display_bind = *bind;
+
+   if (!settings || !settings->bools.input_bind_controller_only)
+      return;
+
+   joy_idx = settings->uints.input_joypad_index[0];
+   if (joy_idx >= MAX_USERS)
+      return;
+
+   for (i = 0; i < RARCH_BIND_LIST_END; i++)
+   {
+      const struct retro_keybind *candidate = &input_autoconf_binds[joy_idx][i];
+
+      if (     display_bind->joykey != NO_BTN
+            && display_bind->joykey == candidate->joykey
+            && string_is_empty(display_bind->joykey_label)
+            && !string_is_empty(candidate->joykey_label))
+         display_bind->joykey_label = candidate->joykey_label;
+
+      if (     display_bind->joyaxis != AXIS_NONE
+            && display_bind->joyaxis == candidate->joyaxis
+            && string_is_empty(display_bind->joyaxis_label)
+            && !string_is_empty(candidate->joyaxis_label))
+         display_bind->joyaxis_label = candidate->joyaxis_label;
+
+      if (     (display_bind->joykey == NO_BTN
+               || !string_is_empty(display_bind->joykey_label))
+            && (display_bind->joyaxis == AXIS_NONE
+               || !string_is_empty(display_bind->joyaxis_label)))
+         break;
+   }
+}
