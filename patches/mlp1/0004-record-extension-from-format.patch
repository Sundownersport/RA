Derive the recording file extension from the configured container.

RetroArch picks the extension from video_record_quality, not from the muxer it
actually writes: every quality below WEBM_FAST gets ".mkv" hardcoded, and custom
(RECORD_CONFIG_TYPE_RECORDING_CUSTOM = 0) falls in that range. So a custom preset
writing MP4 produces a file named .mkv containing MP4. Discord, browsers and
phones all dispatch on extension, so a correct MP4 nobody can preview is the same
practical failure as the WAV-in-MKV this device shipped before.

For the custom case only, read the "format" key out of the record config the user
already pointed at and choose the extension from it. An unreadable config or an
unrecognised format falls back to the original "mkv", so no existing setup can
get worse.

diff --git a/record/record_driver.c b/record/record_driver.c
index b3f44a648b..1668de9347 100644
--- a/record/record_driver.c
+++ b/record/record_driver.c
@@ -19,6 +19,7 @@
 #include <compat/strl.h>
 #include <string/stdstring.h>
 #include <file/file_path.h>
+#include <file/config_file.h>
 #include <retro_math.h>
 
 #include "../configuration.h"
@@ -71,6 +72,47 @@ const char* config_get_record_driver_options(void)
    return char_list_new_special(STRING_LIST_RECORD_DRIVERS, NULL);
 }
 
+/* RetroArch chooses the recording extension from the quality preset rather than
+ * from the container it writes, so a custom preset muxing MP4 still lands as
+ * ".mkv". Platforms dispatch on extension, so read the container the user
+ * actually configured and name the file after it. Returns NULL when there is
+ * nothing usable to say, and the caller keeps its original default. */
+static const char *jw_record_ext_from_config(const char *config_path)
+{
+   static char ext[8];
+   char format[64];
+   config_file_t *conf;
+
+   if (string_is_empty(config_path))
+      return NULL;
+   if (!(conf = config_file_new_from_path_to_string(config_path)))
+      return NULL;
+
+   format[0] = '\0';
+   if (     !config_get_array(conf, "format", format, sizeof(format))
+         || string_is_empty(format))
+   {
+      config_file_free(conf);
+      return NULL;
+   }
+   config_file_free(conf);
+
+   /* Only the containers this device can actually mux. "mov" and "mp4" share a
+    * muxer in ffmpeg but not an extension, so they are listed separately. */
+   if (string_is_equal(format, "mp4"))
+      strlcpy(ext, "mp4", sizeof(ext));
+   else if (string_is_equal(format, "mov"))
+      strlcpy(ext, "mov", sizeof(ext));
+   else if (string_is_equal(format, "matroska"))
+      strlcpy(ext, "mkv", sizeof(ext));
+   else if (string_is_equal(format, "webm"))
+      strlcpy(ext, "webm", sizeof(ext));
+   else
+      return NULL;
+
+   return ext;
+}
+
 static void find_record_driver(void)
 {
    settings_t *settings = config_get_ptr();
@@ -247,8 +289,18 @@ bool recording_init(void)
 
