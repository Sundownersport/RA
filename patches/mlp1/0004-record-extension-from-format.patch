+             * qualities below WEBM_FAST are all Matroska. */
+            const char *ext = NULL;
+
+            if (video_record_quality == RECORD_CONFIG_TYPE_RECORDING_CUSTOM)
+               ext = jw_record_ext_from_config(
+                     settings->paths.path_record_config);
+            if (!ext)
+               ext = "mkv";
+
